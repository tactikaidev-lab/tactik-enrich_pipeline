# Copy to .env, fill in real values, and NEVER commit .env to git.
# Passed to the container at runtime via `docker run --env-file .env`.

# Recommended, not strictly required: if unset, vsbn/transcend fall back to free
# site-scraping instead of erroring (lower confidence — see enrich_pipeline.py).
HUNTER_API_KEY=
# bali only — no free fallback for phone-based enrichment, these rows stay
# blank until keys are set.
APOLLO_API_KEY=
PDL_API_KEY=

# Only needed if you run with --airtable-push
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
