# Copy to .env, fill in real values, and NEVER commit .env to git.
# Passed to the container at runtime via `docker run --env-file .env`.

# Recommended, not strictly required: if unset, vsbn/transcend fall back to free
# site-scraping instead of erroring (lower confidence — see enrich_pipeline.py).
HUNTER_API_KEY=
# bali only — no free fallback for phone-based enrichment, these rows stay
# blank until keys are set.
APOLLO_API_KEY=
PDL_API_KEY=

# Only needed if you run with --airtable-push
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# --- mcp service only (docker compose up -d mcp) — not used by `enrich` ---
# All three required or the server refuses to start. Generate the two
# secrets with: openssl rand -hex 32   (use a DIFFERENT value for each —
# don't reuse one secret for both).
MCP_BEARER_TOKEN=
MCP_UPLOAD_SECRET=
# The public HTTPS URL this server is reachable at, e.g. your Tailscale
# Funnel URL (https://<machine>.<tailnet>.ts.net) — see README for setup.
# No trailing slash.
MCP_PUBLIC_BASE_URL=
